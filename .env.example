# Local PostgreSQL connection (for local development only; Coolify Compose generates this automatically)
DATABASE_URL=postgresql://postgres:replace-this-password@localhost:5432/t2dev_monetization?schema=public


# Dashboard administrator (separate from GAMOB credentials)
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-64-character-random-hex-secret
ADMIN_USERNAME=choose-a-unique-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-password

# GAMOB account credentials: configure only in Coolify, never in GitHub or browser code
GAMOB_EMAIL=your-gamob-account-email
GAMOB_PASSWORD=your-gamob-account-password
GAMOB_API_KEY=token-from-gamob-my-profile

# Reporting configuration
GAMOB_SYNC_INTERVAL_MINUTES=15
GAMOB_INITIAL_HISTORY_MONTHS=12
GAMOB_TIMEOUT_MS=30000
GAMOB_REPORT_CURRENCY=USD
APP_TIMEZONE=Asia/Kolkata
SYNC_SECRET=replace-with-another-long-random-secret

# Used by docker-compose PostgreSQL service
POSTGRES_PASSWORD=replace-with-a-strong-unique-database-password
